# ── Degent Marketplace configuration ──
# Copy to .env and export, or set in your process manager. All values are optional
# unless marked REQUIRED-FOR-BUYS.

# HTTP port
PORT=3000

# Kill switch for the settlement engine. Buying stays paused until the new
# engine has been verified end-to-end on signet. Listing/cancel work regardless.
BUYS_ENABLED=false

# Browser origin allowed to call the API (exact match). Leave empty to allow only
# same-origin requests (no CORS header is sent at all).
CORS_ORIGIN=

# mainnet | testnet | signet. Selects address prefixes and the mempool.space base.
BITCOIN_NETWORK=mainnet

# Esplora/mempool.space REST base. Defaults per network:
#   mainnet https://mempool.space/api
#   testnet https://mempool.space/testnet4/api
#   signet  https://mempool.space/signet/api
MEMPOOL_API=

# Inscription indexer used to verify a listing's current location/owner.
#   ord  -> ORD_API (recursive endpoints /r/inscription/{id}, /r/utxo/{outpoint})
#   hiro -> HIRO_API (/ordinals/v1/inscriptions/{id})
INDEXER=ord
ORD_API=https://ordinals.com
HIRO_API=https://api.hiro.so

# Refuse to spend a buyer UTXO unless the indexer confirms it carries no
# inscription. Set to false only on networks the indexer does not cover.
UTXO_SAFETY_CHECK=true

# SQLite file (kept OUTSIDE public/). Directory is created on start.
DB_PATH=./data/market.db

# Royalty on every sale, in basis points (100 = 1%). 0 disables the royalty
# output. REQUIRED-FOR-BUYS when > 0: TREASURY_ADDRESS must be set.
ROYALTY_BPS=0
TREASURY_ADDRESS=

# Listing limits
PRICE_MIN_SATS=1000
PRICE_MAX_SATS=10000000000
LISTING_MAX_DAYS=30

# Settlement watcher poll interval (ms) and how long a broadcast buy may sit
# unseen before the listing is returned to "active".
WATCHER_INTERVAL_MS=60000
PENDING_TIMEOUT_MS=21600000

# Sign-in challenge / buy session lifetimes (seconds)
CHALLENGE_TTL_SEC=600
BUY_SESSION_TTL_SEC=600
