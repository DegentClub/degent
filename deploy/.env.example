# Env for deploy/compose.signet.yml. Copy to deploy/.env and fill in.
#
#   cp deploy/.env.example deploy/.env
#
# NEVER commit deploy/.env (it is git-ignored). Every value marked "SOPS:" below
# comes from the fleet's secret store at that path (see /home/user/infrastructure
# CLAUDE.md "Secrets (SOPS)"); fetch with, e.g.:
#   fleet devtools secrets keys list | grep degent-mint
# Values with no SOPS: comment are non-secret configuration (URLs, ids, slugs) --
# still never hardcode real fleet IPs; use the Fleet API / `fleet dev connect` to
# resolve current addresses (see docs/fleet-handoff.md).

# ---- RabbitMQ (platform event bus) ----
RABBITMQ_USER=degent
# SOPS: services/rabbitmq/degent-password
RABBITMQ_PASSWORD=
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Host port mapping (local/staging only; prod is behind the fleet's edge) ----
MINT_PORT=8787
STUDIO_PORT=8790
ATELIER_PORT=8788
WEB_PORT=8080
# Origin the browser calls mint/studio/atelier from (CORS_ORIGINS on each service).
WEB_ORIGIN=http://localhost:8080

# ---- Fleet signet Bitcoin endpoints (mint + web) ----
# Resolve current URLs with `fleet dev connect btc-signet` / `indexer-signet`, or
# curl https://fleet-mcp.hs.skrybit.dev/api/services/btc-signet -- do not hardcode
# IPs. These are signet only; never point this compose at mainnet or testnet.
SIGNET_ESPLORA_URL=
SIGNET_ORD_URL=
# Block-lane broadcast (optional on signet; esplora fallback is used if unset).
SIGNET_LIBRE_RPC_URL=
SIGNET_LIBRE_RPC_USER=
# SOPS: services/degent-mint/libre-rpc-pass
SIGNET_LIBRE_RPC_PASS=
SLIPSTREAM_URL=
# SOPS: services/degent-mint/slipstream-api-key
SLIPSTREAM_API_KEY=

# ---- degent-mint (products/degent/services/mint/env.schema.json) ----
MINT_PARENT_INSCRIPTION_ID=
# Only needed the first time the store has no known parent UTXO yet.
MINT_PARENT_OUTPOINT=
MINT_PARENT_VALUE_SATS=10000
MINT_COLLECTION_ADDRESS=
# SOPS: services/degent-mint/reveal-encryption-key (32-byte hex, AES-256-GCM)
MINT_REVEAL_ENCRYPTION_KEY=
# Remote policy signer (platform/signer, DegentClub/scribbit) -- shared platform
# service; not built by this compose. See docs/fleet-handoff.md.
SIGNER_URL=
# SOPS: services/degent-mint/signer-api-key (bsh_live_... or bsh_test_...)
MINT_SIGNER_API_KEY=
MINT_SIGNER_KEY_ID=degent-parent
# SOPS: services/degent-mint/studio-api-key (scope studio:internal)
MINT_STUDIO_API_KEY=
# Platform ledger (platform/ledger, DegentClub/scribbit) -- optional; unset means
# artwork orders are not recorded to the ledger.
LEDGER_URL=
# SOPS: services/degent-mint/ledger-api-key
MINT_LEDGER_API_KEY=
ROYALTY_BPS=1000
CLUB_FEE_BPS_STANDARD=1000
CLUB_FEE_BPS_LARGE=1000
CLUB_FEE_BPS_FULLBLOCK=1000
SERVICE_FEE_ADDRESS=
# SOPS: services/degent-mint/admin-api-key-hashes (JSON array; hash-only, no plaintext)
MINT_ADMIN_API_KEYS_JSON=
# SOPS: services/degent-mint/art-review-api-key (Anthropic key; unset disables vision review)
ART_REVIEW_API_KEY=

# ---- degent-studio (products/degent/services/studio/env.schema.json) ----
STUDIO_PUBLIC_BASE_URL=https://studio.degent.club
STUDIO_SIWB_DOMAIN=studio.degent.club
STUDIO_SIWB_URI=
# SOPS: services/degent-studio/session-signing-key (32-byte hex Ed25519 secret)
STUDIO_SESSION_SIGNING_KEY=
# Comma-separated <kid>:<pubkey hex> pairs still accepted after a rotation.
STUDIO_SESSION_PREVIOUS_KEYS=
# SOPS: services/degent-studio/api-keys (JSON array, hash-only)
STUDIO_API_KEYS=
# SOPS: services/degent-studio/vision-review-api-key (Anthropic key)
VISION_REVIEW_API_KEY=
# SOPS: services/degent-studio/telegram-bot-token
TELEGRAM_BOT_TOKEN=

# ---- degent-atelier (products/degent/services/atelier/env.schema.json) ----
ATELIER_PUBLIC_BASE_URL=https://atelier.degent.club
# fake | openai | http -- fake needs no key (procedural placeholder art).
ATELIER_MODE=fake
# SOPS: services/degent-atelier/openai-api-key
OPENAI_API_KEY=
HTTP_PROVIDER_URL=
# SOPS: services/degent-atelier/http-provider-api-key
HTTP_PROVIDER_API_KEY=
ATELIER_GLOBAL_DAILY_COST_CENTS=2000

# ---- degent-web build args (VITE_* -- inlined at `vite build` time, not runtime) ----
VITE_MINT_API_URL=http://localhost:8787
VITE_STUDIO_API_URL=http://localhost:8790
VITE_EXPLORER_URL=https://explore.block.space
VITE_CERTIFY_URL=https://certify.block.space
VITE_COLLECTION_SLUG=degents
VITE_POLL_MS=
VITE_GALLERY_PAGE_SIZE=
VITE_COMIC_INSCRIPTION_ID=
