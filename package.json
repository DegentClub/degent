{
  "name": "degent",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:root",
    "test:root": "vitest run --config vitest.config.ts",
    "contracts:diff": "node scripts/contracts-diff.mjs",
    "deploy:env": "node products/degent/deploy/gen-env.mjs",
    "rehearsal": "node scripts/rehearsal/run.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "catalog": "pnpm --filter @bsh/catalog-tool run catalog",
    "validate": "pnpm --filter @bsh/catalog-tool run validate",
    "lint:boundaries": "pnpm --filter @bsh/catalog-tool run boundaries",
    "check": "pnpm validate && pnpm lint:boundaries && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.3.2",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
