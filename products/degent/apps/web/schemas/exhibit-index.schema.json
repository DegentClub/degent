{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://degent.club/schemas/exhibit-index.schema.json",
  "title": "ExhibitIndex",
  "description": "The Full Block Exhibit index: every Full Block Degent in the collection with its on-chain facts and block-fraction. source/certified say whether the membership was certified by block.space or is the bundled (uncertified/demo) manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection", "source", "certified", "blockWeightLimitWU", "fullBlockTierMinBytes", "count", "items"],
  "properties": {
    "collection": { "type": "string" },
    "source": { "enum": ["certified", "bundled"] },
    "certified": { "type": "boolean" },
    "blockWeightLimitWU": { "const": 4000000 },
    "fullBlockTierMinBytes": { "const": 3500000 },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "exhibit-item.schema.json" }
    }
  }
}
