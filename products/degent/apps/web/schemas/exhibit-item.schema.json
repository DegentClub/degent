{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://degent.club/schemas/exhibit-item.schema.json",
  "title": "ExhibitItem",
  "description": "One Full Block Degent as a museum object: recorded on-chain facts plus its reveal weight as a fraction of one Bitcoin block. Reveal weight/vsize/fraction are estimated from the content length (estimated=true).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number", "id", "name", "tier", "lane", "contentBytes", "revealWeightWU",
    "revealVsize", "blockWeightLimitWU", "blockFraction", "feeRate", "facts", "estimated", "links"
  ],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "name": { "type": "string" },
    "tier": { "const": "fullblock" },
    "lane": { "const": "block" },
    "contentBytes": { "type": "integer", "minimum": 0 },
    "revealWeightWU": { "type": "integer", "minimum": 0 },
    "revealVsize": { "type": "integer", "minimum": 0 },
    "blockWeightLimitWU": { "const": 4000000 },
    "blockFraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "feeRate": { "type": ["number", "null"], "minimum": 0 },
    "estimated": { "type": "boolean" },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "height", "feeSats", "address", "contentType"],
      "properties": {
        "timestamp": { "type": ["string", "null"] },
        "height": { "type": ["integer", "null"] },
        "feeSats": { "type": ["integer", "null"] },
        "address": { "type": ["string", "null"] },
        "contentType": { "type": ["string", "null"] }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinals", "ordiscan", "magicEden", "xray", "theater"],
      "properties": {
        "ordinals": { "type": "string" },
        "ordiscan": { "type": "string" },
        "magicEden": { "type": "string" },
        "xray": { "type": ["string", "null"] },
        "theater": { "type": ["string", "null"] }
      }
    }
  }
}
