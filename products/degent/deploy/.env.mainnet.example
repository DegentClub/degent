# GENERATED by products/degent/deploy/gen-env.mjs from products/degent/services/mint/env.schema.json and
# products/degent/deploy/compose-vars.json. Do not edit: change those, then run the generator.
#
#   cp .env.mainnet.example .env.mainnet   # fill in every empty REQUIRED value
#   docker compose -f compose.mainnet.yaml --env-file .env.mainnet up -d --build
#
# No secret values in this file: secrets are files in $SECRETS_DIR (listed below).

# ============================================================ degent-mint service (env.schema.json)

# esplora / mempool.space-compatible REST base, e.g. https://mempool.space/api. Also the standard-lane
# broadcaster (POST /tx).
# REQUIRED on mainnet.
ESPLORA_URL=

# ord server base; GET /content/<inscription id> is used for verification.
# REQUIRED on mainnet.
ORD_URL=

# Libre Relay bitcoind JSON-RPC URL (block lane). On mainnet, without this and without SLIPSTREAM_URL the
# block tier is not offered (standard lane only); on test networks the block lane falls back to esplora.
# LIBRE_RPC_URL=

# LIBRE_RPC_USER=

# MARA Slipstream base URL (block lane), e.g. https://slipstream.mara.com.
# SLIPSTREAM_URL=

# Collection parent inscription id (envelope tag 3).
# REQUIRED on mainnet.
PARENT_INSCRIPTION_ID=

# Initial location of the parent UTXO; only read when the store has none yet.
# Set it for mainnet (no safe default).
PARENT_OUTPOINT=

# Taproot address of the parent key; must equal the signer's address.
# REQUIRED on mainnet.
COLLECTION_ADDRESS=

# Comma-separated exact origins allowed for browser calls. Empty = deny all.
CORS_ORIGINS=https://degent.club

# Optional text file replacing the default art guidelines prompt.
# ART_REVIEW_GUIDELINES_FILE=

# Address that must receive the service fee in the funding tx. Required if a fee is set.
# SERVICE_FEE_ADDRESS=

# SERVICE_FEE_SATS_STANDARD=0

# SERVICE_FEE_SATS_BLOCK=0

# Minimum reveal fee rate, sat/vB.
# MIN_FEE_RATE=1

# QUOTE_TTL_SECONDS=900

# RESCUE_AFTER_SECONDS=21600

# LATE_PAYMENT_WINDOW_SECONDS=604800

# Standard-lane reveals in flight (1-24; the parent chain must stay under the 25-descendant mempool limit).
# STANDARD_CONCURRENCY=12

# CONFIRMATIONS=1

# WORKER_INTERVAL_MS=15000

# POST/PUT requests per client IP per minute.
# RATE_LIMIT_PER_MINUTE=60

# Member approvals that move an order from member_review to queued (ADR-0007).
# APPROVAL_QUORUM=3

# Member declines that move an order from member_review to declined (self-rescue offered at once).
# DECLINE_QUORUM=3

# member_review -> rescue_available after this long without a decision (default 14 days); 3600..7776000.
# REVIEW_SLA_SECONDS=1209600

# Lower-case host[:port] holder sign-ins are bound to (SIWB domain), e.g. degent.club. Dev default
# localhost:8787.
# REQUIRED on mainnet.
SIWB_DOMAIN=degent.club

# URI in the SIWB challenge; defaults to https://<SIWB_DOMAIN> (http only for loopback).
# SIWB_URI=

# SIWB_CHALLENGE_TTL_SECONDS=300

# Key id in session token headers; change it when rotating SESSION_KEY.
# SESSION_KID=k1

# SESSION_TTL_SECONDS=3600

# Who counts as a member: roster-chain (roster.json + ord/esplora ownership; default off regtest) or memory
# (dev only, refused on mainnet).
# One of: memory, roster-chain.
HOLDER_REGISTRY=roster-chain

# Public ord base used for explorer image URLs (<base>/content/<id>). Defaults to ORD_URL.
ORD_PUBLIC_URL=https://ordinals.com

# Inscription id of the signed Gallery (docs/REGISTER.md) once the owner inscribed it; shown by GET
# /v1/register.
# GALLERY_INSCRIPTION_ID=

# ============================================================ secrets (files, never values here)
# One file per secret in $SECRETS_DIR, readable by uid 1000 only. Suggested SOPS paths in parentheses.
#   LIBRE_RPC_PASS  <- $SECRETS_DIR/libre-rpc-pass  (services/degent-mint/libre-rpc-pass)  [optional: empty file = unset]
#   SLIPSTREAM_API_KEY  <- $SECRETS_DIR/slipstream-api-key  (services/degent-mint/slipstream-api-key)  [optional: empty file = unset]
#   PARENT_KEY_FILE: not used on mainnet (the parent key lives in the KMS signer; the service refuses a key file)
#   REVEAL_ENCRYPTION_KEY  <- $SECRETS_DIR/reveal-encryption-key  (services/degent-mint/reveal-encryption-key)  [REQUIRED]
#   ART_REVIEW_API_KEY  <- $SECRETS_DIR/art-review-api-key  (services/degent-mint/art-review-api-key)  [optional: empty file = unset]
#   SESSION_KEY  <- $SECRETS_DIR/session-key  (services/degent-mint/session-key)  [REQUIRED]

# ============================================================ deployment (compose-vars.json)

# Image name prefix (registry/namespace) for mint, mint-backup and web images.
DEGENT_IMAGE_PREFIX=degent

# Image tag. Signet builds locally; mainnet runs the exact mint images rehearsed on signet, promoted by tag
# (git commit).
# REQUIRED on mainnet.
DEGENT_IMAGE_TAG=

# Host directory holding one file per secret (see the secrets list). Files must be readable by uid 1000 and
# nobody else (chmod 0400, chown 1000). An empty file means unset for optional secrets.
# REQUIRED on mainnet.
SECRETS_DIR=

# Host path of the Gallery roster JSON mounted read-only as ROSTER_FILE. Signet member votes need a signet
# roster (docs/REHEARSAL.md).
ROSTER_PATH=../services/mint/data/roster.json

# Host address the web container publishes on. Keep 127.0.0.1 behind a TLS edge.
WEB_BIND=127.0.0.1

# Host port the web container publishes on.
WEB_PORT=8080

# Browser-facing esplora API (UTXOs, broadcast) for the SAME chain as ESPLORA_URL (the fleet's private signet
# is not mempool.space/signet). Build-time, public.
VITE_ESPLORA_URL=https://mempool.space/api

# Browser-facing ord server for /content/<id>. Build-time, public.
VITE_ORD_URL=https://ordinals.com

# Block explorer for tx links. Build-time, public.
VITE_EXPLORER_URL=https://explore.block.space

# Public site origin used in share links. Build-time, public.
VITE_SITE_URL=https://degent.club

# Telegram gate endpoint for /verify; empty disables the page. Build-time, public.
VITE_GATE_URL=

# Order polling interval in the browser (ms). Build-time.
VITE_POLL_MS=5000

# Space-separated extra connect-src origins for the web CSP: the browser-facing esplora and gate origins.
CSP_CONNECT_SRC=https://mempool.space

# Space-separated extra img-src origins for the web CSP: the browser-facing ord origin.
CSP_IMG_SRC=https://ordinals.com

# Content-Security-Policy, or Content-Security-Policy-Report-Only while diagnosing a wallet extension in a
# rehearsal.
CSP_HEADER=Content-Security-Policy

# Host directory receiving sqlite snapshots and content blobs (mint-backup service). Put it on a different
# disk, then ship it off-host.
# REQUIRED on mainnet.
BACKUP_DIR=

# Seconds between backups.
BACKUP_INTERVAL_SECONDS=3600

# Database snapshots to keep (content blobs are never pruned).
BACKUP_KEEP=48
