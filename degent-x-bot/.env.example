# X/Twitter API
X_API_KEY=your_consumer_key
X_API_SECRET=your_consumer_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=gpt-4o
OPENROUTER_KEY=

# Database
# docker compose requires POSTGRES_PASSWORD and REDIS_PASSWORD and derives the
# connection URLs itself. For a bare `npm start` write the full URLs below
# (dotenv does not expand ${VARS}). The built-in dgentx:dgentx default is
# rejected in production.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgresql://dgentx:<POSTGRES_PASSWORD>@localhost:5432/dgentx
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# Storage
S3_BUCKET=degent-media
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Admin — REQUIRED. Startup refuses placeholder values in production.
#   JWT_SECRET:     >= 32 chars, e.g. `openssl rand -hex 32`
#   ADMIN_PASSWORD: >= 12 chars
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Only for local test runs: ALLOW_INSECURE_DEFAULTS=true

# Telegram holders gate (npm run gate / compose service telegram-gate)
# A SEPARATE bot from TELEGRAM_BOT_TOKEN. Must be admin of HOLDERS_CHAT_ID
# with "invite users via link" and "ban users" rights.
TELEGRAM_GATE_BOT_TOKEN=
HOLDERS_CHAT_ID=
# Where the minter web app serves /verify?tg=<token>
WEB_BASE_URL=https://degent.club
# Collection API: GET ${REGISTER_API_URL}/api/register/holder/:address
REGISTER_API_URL=
# >= 32 chars, different from JWT_SECRET. `openssl rand -hex 32`
GATE_JWT_SECRET=
GATE_PORT=3001

# Alerts
DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=

# Feature Flags
AUTO_POST_ENABLED=true
AUTO_ENGAGE_ENABLED=true
TELEGRAM_PIPELINE_ENABLED=true
# REVIEW_QUEUE_ENABLED=true means nothing posts without a human approving it.
# Setting it to false lets 'auto' tier content (memes, gm, replies) post on its
# own. 'review' and 'manual' tier content always waits for approval.
REVIEW_QUEUE_ENABLED=true

# Agent brain (defaults to ./brain/DEGENT_X_BOT_BRAIN.md)
# BRAIN_PATH=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
